# Deploy target — defaults already point at the hackathon Pi (pi-06),
# reachable directly on the event Wi-Fi.
PI_HOST=pi-06.local
PI_PORT=22
PI_USER=hacker6
PI_DIR=/home/hacker6/app

# Runtime config (read by src/devinhackathon/main.py)
PORT=3000
LED_PIN=17

# Self-signed HTTPS listener for live-AR camera mode (iPhones need HTTPS
# for getUserMedia). Set TLS_PORT=0 to disable; HTTP on $PORT stays plain.
TLS_PORT=3443
TLS_CERT=certs/cert.pem
TLS_KEY=certs/key.pem
